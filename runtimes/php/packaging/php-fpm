#!/bin/sh
set -eu
# Resolve from the executable, never from the caller's current directory, and
# follow any symlink the caller reached us through: a PATH shim outside the
# bundle names the shim, not this file.
self=$0
n=0
while [ -L "$self" ] && [ "$n" -lt 40 ]; do
    target=$(readlink -- "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(CDPATH='' cd -P -- "$(dirname -- "$self")" && pwd)/$target ;;
    esac
    n=$((n+1))
done
[ "$n" -lt 40 ] || { printf '%s\n' 'Symlink chain too deep to resolve.' >&2; exit 1; }
ROOT=$(CDPATH='' cd -P -- "$(dirname -- "$self")/.." && pwd)
. "$ROOT/libexec/launch.sh"
if [ "$(id -u)" = 0 ]; then
    printf '%s\n' 'PHP-FPM launcher refuses root; run as the application user (no sudo/-R).' >&2
    exit 1
fi
explicit=no
for arg do
    case "$arg" in
        -y|--fpm-config|-y?*|--fpm-config=*) explicit=yes ;;
        -R|--allow-to-run-as-root) printf '%s\n' 'Root override is not supported.' >&2; exit 1 ;;
    esac
done
if [ "$explicit" = no ]; then
    if [ -z "${DEVSTACK_FPM_CONFIG:-}" ] || [ ! -f "$DEVSTACK_FPM_CONFIG" ]; then
        printf '%s\n' 'Supply a caller-owned FPM config with -y/--fpm-config or DEVSTACK_FPM_CONFIG.' >&2
        exit 1
    fi
    set -- -y "$DEVSTACK_FPM_CONFIG" "$@"
fi
exec "$ROOT/libexec/php-fpm" -c "$ROOT/etc/php.ini" -d "extension_dir=$ROOT/lib/php/extensions" "$@"
