{
  "comment": "Module policy for httpd 2.4.70. 'dso' is the expected shared inventory and is compared against what the build actually emits; a module present in neither list fails verification, which is how a silently disabled mod_md or mod_http2 is caught. 'static' is asserted from httpd -l. mod_unixd is a DSO here: ap_unixd_config lives in os/unix/unixd.c, which is part of the server, but the directives are in the loadable mod_unixd.so.",
  "static": [
    "core",
    "http",
    "so"
  ],
  "mpm": {
    "default": "event",
    "shared": [
      "event",
      "worker",
      "prefork"
    ]
  },
  "dso": [
    "access_compat",
    "actions",
    "alias",
    "allowmethods",
    "asis",
    "auth_basic",
    "auth_digest",
    "auth_form",
    "authn_anon",
