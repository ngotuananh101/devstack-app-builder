    "watchdog",
    "xml2enc"
  ],
  "excluded": [
    {
      "name": "isapi",
      "reason": "Windows-only module; modules/arch/win32/config.m4 has no Linux counterpart."
    },
    {
      "name": "socache_dc",
      "reason": "distcache has been unmaintained since 2005 and is not part of Lounge."
    },
    {
      "name": "systemd",
      "reason": "Requires libsystemd and a systemd-managed host; a portable bundle must not link it, and Lounge does not ship it."
    },
    {
      "name": "privileges",
      "reason": "Solaris-style privilege model that only works on hosts built with the matching kernel interfaces; not in Lounge and not portable."
    }
  ],
  "conflicts": {
    "mpm": [
      "event",
      "worker",
      "prefork"
    ],
    "oneof": [
      [
        "cgi",
        "cgid"
      ]
    ]
  }
}
